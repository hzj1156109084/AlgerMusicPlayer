# Android (Capacitor) 构建专用
#
# VITE_NCM_EMBEDDED 是端内网易云 API 层的开关：
#   true  → utils/request.ts 会挂上 ncm 适配器，所有网易云请求在设备本地完成，
#           不经过任何服务器，用户的 MUSIC_U Cookie 不离开设备。
#   未定义 → 桌面端走 Electron 内置的 127.0.0.1 本地服务（主进程 server.ts 启动）。
#
# 这个变量必须在桌面端的 .env.development / .env.production 里保持缺失，
# 这样 `import.meta.env.VITE_NCM_EMBEDDED === 'true'` 会被静态求值为 false，
# 整个端内 API 层连同其依赖都不会进桌面端打包产物。

VITE_NCM_EMBEDDED = true

# 端内完成所有请求，这个 baseURL 只是给 axios 一个合法形状，
# 适配器只取路径部分，不会真的向它发请求。
VITE_API = http://ncm.local

# utils/request_music.ts 是**另一个** axios 实例，指向第三方音乐解析服务
# （自定义音源 / 破解接口），与端内网易云层完全无关。
#
# ⚠️ 这里不填地址，musicParser 的候选解析源就会全部失败 —— 这是**有意的**：
#    那些服务要么是公开实例（会把请求连同你的 cookie 送到第三方），
#    要么需要你自己部署。移动端先只走官方 /song/url/v1。
#    待验证：musicParser 的失败是否被逐级 catch 并回退到官方接口（Phase 5）。
VITE_API_MUSIC =
